# Copy to .env and adjust. Read by docker-compose.yml. Full guide: docker/README.md

# Host folder the tools can READ (source code, binaries, captures...), mounted read-only at /targets.
# Mount a parent folder to give access to several repositories (/targets/repo-a, /targets/repo-b).
# Windows: use forward slashes, e.g. C:/Users/you/Projects
HEXSTRIKE_TARGETS=./targets

# Host folder for reports and tool output, mounted read/write at /workspace
HEXSTRIKE_WORKSPACE=./workspace

# Address host.docker.internal resolves to inside the container (your machine).
# Docker Desktop, OrbStack, Linux: leave unset (host-gateway).
# Rancher Desktop: required. Use the address from `rdctl shell grep internal /etc/hosts`,
# usually 192.168.127.254 on Windows with the networking tunnel.
# HEXSTRIKE_HOST_IP=192.168.127.254

TZ=Europe/Rome
