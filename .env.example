# Copy to .env and adjust. Read by docker-compose.yml.

# Host folder the tools can READ (source code, binaries, captures...), mounted read-only at /targets
# Windows example: HEXSTRIKE_TARGETS=C:/Users/you/Projects
HEXSTRIKE_TARGETS=./targets

# Host folder for reports and tool output, mounted read/write at /workspace
HEXSTRIKE_WORKSPACE=./workspace

# Address the container uses for host.docker.internal (the host machine).
# Leave unset for Linux, Docker Desktop and OrbStack (defaults to host-gateway).
# Rancher Desktop: use the address from `rdctl shell grep internal /etc/hosts`,
# e.g. 192.168.127.254 when its networking tunnel is enabled.
# HEXSTRIKE_HOST_IP=192.168.127.254

TZ=Europe/Rome
